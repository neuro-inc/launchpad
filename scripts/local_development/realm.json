{
  "realm": "launchpad",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "client": {
      "frontend": [
        {
          "name": "admin"
        },
        {
          "name": "user"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://dev.localhost:13000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://dev.localhost:13000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://dev.localhost:13000/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "account-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "account",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@example.test",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "local-development",
          "temporary": false
        }
      ],
      "clientRoles": {
        "frontend": [
          "admin",
          "user"
        ]
      },
      "realmRoles": [
        "offline_access"
      ]
    }
  ]
}
