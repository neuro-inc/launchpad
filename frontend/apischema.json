    "/api/v1/apps": {
      "get": {
        "summary": "View Get Apps Pool",
        "description": "Get the pool of available app templates.\n\nReturns all non-internal templates from the AppTemplate table.",
        "operationId": "view_get_apps_pool_api_v1_apps_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size",
              "default": 50,
              "title": "Size"
            },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_LaunchpadAppRead_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/install": {
      "post": {
        "summary": "View Post Install Generic App",
        "description": "Install a generic app with custom template and configuration.\n\nThis endpoint:\n1. Creates/updates an AppTemplate record with the provided metadata\n2. Installs the app using that template\n\nExample request body:\n```json\n{\n    \"template_name\": \"my-template\",\n    \"template_version\": \"1.0.0\",\n    \"inputs\": {\n        \"displayName\": \"My Custom App\",\n        \"preset\": {\"name\": \"cpu-small\"},\n        \"custom_config\": {\"key\": \"value\"}\n    },\n    \"name\": \"my-custom-app\",\n    \"verbose_name\": \"My Custom App\",\n    \"description_short\": \"A custom application\",\n    \"logo\": \"https://example.com/logo.png\"\n}\n```",
        "operationId": "view_post_install_generic_app_api_v1_apps_install_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenericAppInstallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchpadInstalledAppRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/import": {
      "post": {
        "summary": "View Post Import App",
        "description": "Import an externally installed app from Apps API.\n\nThis endpoint:\n1. Fetches app instance details from Apps API\n2. Fetches template metadata from Apps API\n3. Creates/updates AppTemplate with the metadata\n4. Links the existing app installation to the template\n\nYou can override metadata when importing.\n\nExample request body:\n```json\n{\n    \"app_id\": \"123e4567-e89b-12d3-a456-426614174000\",\n    \"name\": \"my-imported-app\",\n    \"verbose_name\": \"My Imported App\",\n    \"description_short\": \"An externally installed app\",\n    \"logo\": \"https://example.com/logo.png\"\n}\n```",
        "operationId": "view_post_import_app_api_v1_apps_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportAppRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchpadInstalledAppRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/templates/import": {
      "post": {
        "summary": "View Post Import Template",
        "description": "Import a template from Apps API to make it available in the app pool.\n\nThis endpoint:\n1. Fetches template metadata from Apps API\n2. Creates/updates AppTemplate record\n3. Does NOT install the app (just adds template to pool)\n\nYou can configure whether apps from this template are shared and override metadata.\n\nExample request body:\n```json\n{\n    \"template_name\": \"my-template\",\n    \"template_version\": \"1.0.0\",\n    \"is_shared\": false,\n    \"name\": \"my-custom-name\",\n    \"verbose_name\": \"My Custom Template\",\n    \"description_short\": \"A custom template\"\n}\n```",
        "operationId": "view_post_import_template_api_v1_apps_templates_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportTemplateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchpadTemplateRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/{app_name}": {
      "post": {
        "summary": "View Post Run App",
        "description": "Install or get an app by template name.\n\nIf the app is not installed, it will be installed using the template from AppTemplate table.\nIf the app is already installed, returns the existing installation.\nThis endpoint is safe for polling - it will not create duplicate installations.",
        "operationId": "view_post_run_app_api_v1_apps__app_name__post",
        "parameters": [
          {
            "name": "app_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "App Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchpadInstalledAppRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
